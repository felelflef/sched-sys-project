# Gemini API Key for AI Classroom & Timetable Optimization
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# Database Configuration (Optional - for MySQL / Cloud deployment)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sti_classroom_system
DB_USER=root
DB_PASS=
DB_SSL=false
# Optional path to the provider's CA certificate. When set, the server certificate is verified.
DB_SSL_CA=
