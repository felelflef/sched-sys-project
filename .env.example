# Gemini API Key for AI Classroom & Timetable Optimization
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# PostgreSQL database. On a school PC, local/setup.ps1 writes these for you.
# For Aiven: its host and port, DB_USER=avnadmin and DB_SSL=true.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=defaultdb
DB_USER=sti_app
DB_PASS=
DB_SSL=false
# Optional path to the provider's CA certificate. When set, the server certificate is verified.
DB_SSL_CA=

# Local copy only (local/start.ps1 and local/backup.ps1): the port the app answers on, and PostgreSQL's bin folder
APP_PORT=8080
PG_BIN=
# Where backups are saved, such as the school OneDrive folder (setup fills it in when OneDrive is signed in). Blank = local\backups
BACKUP_DIR=
